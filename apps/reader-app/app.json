{
  "expo": {
    "name": "Agnisiragu",
    "slug": "agnisiragu",
    "scheme": "agnisiragu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1EB"
      },
      "package": "com.agnisiragu.reader",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.agnisiragu.reader",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-source.png.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F1EB"
        }
      ],
      "expo-image",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "செய்தி பதிவேற்ற புகைப்படங்களை தேர்ந்தெடுக்க அனுமதி தேவை / Allow access to your photos to attach images to a news report.",
          "cameraPermission": "செய்தி பதிவேற்ற புகைப்படம்/வீடியோ எடுக்க கேமரா அனுமதி தேவை / Allow camera access to capture photos or video for a news report."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "உங்கள் அருகிலுள்ள செய்திகளை காட்டவும், பதிவிடும் செய்திக்கு இருப்பிடத்தை இணைக்கவும் இருப்பிட அனுமதி தேவை / Allow location access to show news near you and tag the location on a submitted report."
        }
      ],
      "./plugins/withShareAppQueries.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "354230e7-7a81-410e-92b3-44c0607c32d0"
      }
    },
    "owner": "agnisiragu_new"
  }
}
