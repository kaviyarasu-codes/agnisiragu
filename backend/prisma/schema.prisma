// prisma/schema.prisma
// Agnisiragu News Platform — Phase 1 Schema
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  READER
  REPORTER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  EDITOR_MANAGER
  EDITOR_MEMBER
  VERIFICATION_MANAGER
  VERIFICATION_MEMBER
  REPORTER_APP_MANAGER
  REPORTER_APP_MEMBER
  REPORTERS_MANAGER
  REPORTERS_MEMBER
  ADVERTISEMENT_MANAGER
  LOCAL_ADS_MANAGER
  ADMOB_MANAGER
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNPUBLISHED
  DELETED
}

// Admin-controlled feed card layout override (product decision: only an
// admin may pick this — see the checkbox group in the admin panel's article
// form). STANDARD means "no explicit choice" and falls back to the app's
// legacy automatic rules (isBreaking -> full-bleed, Cinema category ->
// peeking-deck) so existing articles keep rendering exactly as before.
enum CardStyle {
  STANDARD    // "A" — the default feed card
  FULL_BLEED  // "B" / design screen 1b — full-bleed breaking-style photo card
  NEWSPRINT   // design screen 1c — headline-first newsprint order
}

enum ReporterStatus {
  TEMPORARY
  VERIFIED
  SENIOR
  PRESS_ID
}

enum NewsStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NewsPriority {
  BREAKING
  REGULAR
  LOW
}

enum AdType {
  IMAGE
  VIDEO
  BANNER
  CAROUSEL
}

enum CtaType {
  WHATSAPP
  PHONE
  WEBSITE
  EMAIL
  MAPS
  FORM
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdPlacement {
  ADMOB
  LOCAL
  BOTH
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ─── Phase 1 Models ──────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  phone            String        @unique
  name             String?
  role             Role          @default(READER)
  articleReadCount Int           @default(0)
  fcmToken         String?
  preferredLang    String        @default("ta") // "ta" | "en"
  isBanned         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  articleReads     ArticleRead[]
  pushTokens       PushToken[]

  // Legacy Phase 2 relations (kept for forward compatibility)
  reporter         Reporter?
  comments         Comment[]
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  adminRole    AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  phone        String?
  teamType     String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  articles     Article[]
  auditLogs    AuditLog[]
  mediaFiles   MediaFile[]
  localAds     LocalAd[]

  // Task-assignment system (My Profile page): tasks this admin was given,
  // and tasks this admin handed out to others. See Task model below for the
  // assignment-hierarchy rule enforced in tasks.service.ts.
  tasksAssignedToMe Task[] @relation("TaskAssignedTo")
  tasksICreated     Task[] @relation("TaskAssignedBy")

  // Support tickets (My Profile "Support" tab): issues a Manager/Member
  // raises for an Admin/Super Admin to resolve. See Ticket model below.
  ticketsRaised   Ticket[] @relation("TicketRaisedBy")
  ticketsResolved Ticket[] @relation("TicketResolvedBy")
}

model Category {
  id           String    @id @default(uuid())
  nameTa       String
  nameEn       String
  slug         String    @unique
  iconUrl      String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  articles     Article[]
}

model Article {
  id           String        @id @default(uuid())
  titleTa      String
  titleEn      String
  bodyTa       String
  bodyEn       String
  excerpt      String?
  thumbnailUrl String?
  // Extra gallery photos/videos beyond the single thumbnail — see
  // CreateArticleDto.mediaUrls. Empty by default; the reader app falls
  // back to a single-image card using thumbnailUrl when this is empty.
  mediaUrls    String[]      @default([])
  byline       String?       // "by Publisher Name" shown in reader app
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  adminId      String
  admin        Admin         @relation(fields: [adminId], references: [id])
  status       ArticleStatus @default(DRAFT)
  isBreaking   Boolean       @default(false)
  cardStyle    CardStyle     @default(STANDARD)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Reaction counters — increment-only from the client, deduped on-device
  // (AsyncStorage) rather than per-account, so guests can react too. Not a
  // full Like junction table by design: this app's read model is guest-
  // first (most installs never log in), so a per-user unique constraint
  // would exclude the majority of reactions.
  likeCount    Int           @default(0)
  dislikeCount Int           @default(0)
  commentCount Int           @default(0)

  // Precomputed at create/update time (see news.service.ts's buildSearchText)
  // — a normalized blob combining a phonetic Tamil->Latin transliteration of
  // titleTa/bodyTa with titleEn/excerpt/byline, so a reader typing in plain
  // English or Thanglish (e.g. "mazhai") still finds Tamil-only articles
  // (e.g. "மழை") in Archive/Search. Not shown anywhere — search index only.
  searchText   String?       @db.Text

  reads        ArticleRead[]
  comments     Comment[]
}

model ArticleRead {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  readAt    DateTime @default(now())

  @@unique([userId, articleId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fcmToken  String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  device     String?
  createdAt  DateTime @default(now())
}

model MediaFile {
  id        String   @id @default(uuid())
  filename  String
  url       String
  publicId  String
  mimeType  String
  size      Int      @default(0)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}

model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model LocalAd {
  id             String      @id @default(uuid())
  title          String
  description    String?
  adType         AdType
  mediaUrl       String?
  carousel       Json?       // array of image URLs for CAROUSEL type
  startDate      DateTime
  endDate        DateTime
  categoryId     String?
  targetAudience String?
  priority       Int         @default(0)
  status         AdStatus    @default(DRAFT)
  ctaType        CtaType
  ctaValue       String      // WhatsApp number, phone, URL, email, coordinates, etc.
  placement      AdPlacement @default(BOTH)
  clickCount     Int         @default(0)
  impressions    Int         @default(0)
  adminId        String
  admin          Admin       @relation(fields: [adminId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Team {
  id          String   @id @default(uuid())
  name        String
  nameTa      String?
  type        String   @unique  // e.g. 'EDITOR_TEAM', 'EDITORIAL_SPORTS'
  description String?
  color       String   @default("#CC1F2D")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Task-assignment system, part of the "My Profile" feature. Assignment
// hierarchy (enforced in tasks.service.ts, not by the schema):
//   - SUPER_ADMIN / ADMIN -> any Manager or Member, any team
//   - *_MANAGER            -> *_MEMBER on their own team only (teamType match)
//   - *_MEMBER / EDITOR     -> cannot assign, can only update their own
//                              task's status
model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus @default(NEW)
  assignedToId String
  assignedTo   Admin      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   Admin      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignedToId, status])
  @@index([assignedById])
}

// Support tickets, part of the "My Profile" feature. Any Manager or Member
// (any non-SUPER_ADMIN/ADMIN role) can raise one; any SUPER_ADMIN/ADMIN can
// see the shared pool and resolve it (enforced in tickets.service.ts, same
// pattern as Task above — not modeled here since it's a fixed two-tier
// split, unlike Task's team-scoped manager rule).
model Ticket {
  id             String         @id @default(uuid())
  title          String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  resolutionNote String?
  raisedById     String
  raisedBy       Admin          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  resolvedById   String?
  resolvedBy     Admin?         @relation("TicketResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([raisedById])
}

// ─── Legacy / Phase 2 Models (kept, not used in Phase 1 APIs) ────────────────

model Reporter {
  id          String         @id @default(uuid())
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id])
  realName    String
  penName     String
  usePenName  Boolean        @default(true)
  trustScore  Int            @default(50)
  status      ReporterStatus @default(TEMPORARY)
  strikeCount Int            @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  news        News[]
  rewards     Reward[]
}

model News {
  id          String       @id @default(uuid())
  title       String
  body        String
  mediaUrl    String?
  audioUrl    String?
  category    String
  reporterId  String
  reporter    Reporter     @relation(fields: [reporterId], references: [id])
  status      NewsStatus   @default(PENDING)
  priority    NewsPriority @default(REGULAR)
  location    String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  rewards     Reward[]
}

model Reward {
  id         String   @id @default(uuid())
  reporterId String
  reporter   Reporter @relation(fields: [reporterId], references: [id])
  newsId     String
  news       News     @relation(fields: [newsId], references: [id])
  points     Int
  category   String
  claimed    Boolean  @default(false)
  week       String
  paidAt     DateTime?
  createdAt  DateTime @default(now())
}

// Comments on live Article records (Phase 1). Originally modeled against
// the legacy News table — repointed to Article since News/Reporter are
// unused by any Phase 1 API and this model had zero prior usage anywhere
// in the codebase (safe rename, not a breaking change to anything live).
// Reading comments is public; posting requires a logged-in User (phone OTP
// or Google — see auth.controller.ts) enforced in comments.controller.ts.
model Comment {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  isToxic   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}
