// prisma/schema.prisma
// Agnisiragu News Platform — Phase 1 Schema
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  READER
  REPORTER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  EDITOR_MANAGER
  EDITOR_MEMBER
  VERIFICATION_MANAGER
  VERIFICATION_MEMBER
  REPORTER_APP_MANAGER
  REPORTER_APP_MEMBER
  REPORTERS_MANAGER
  REPORTERS_MEMBER
  ADVERTISEMENT_MANAGER
  LOCAL_ADS_MANAGER
  ADMOB_MANAGER
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNPUBLISHED
  DELETED
}

// Admin-controlled feed card layout override (product decision: only an
// admin may pick this — see the checkbox group in the admin panel's article
// form). STANDARD means "no explicit choice" and falls back to the app's
// legacy automatic rules (isBreaking -> full-bleed, Cinema category ->
// peeking-deck) so existing articles keep rendering exactly as before.
enum CardStyle {
  STANDARD    // "A" — the default feed card
  FULL_BLEED  // "B" / design screen 1b — full-bleed breaking-style photo card
  NEWSPRINT   // design screen 1c — headline-first newsprint order
}

enum ReporterStatus {
  TEMPORARY
  VERIFIED
  SENIOR
  PRESS_ID
}

enum NewsStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NewsPriority {
  BREAKING
  REGULAR
  LOW
}

enum AdType {
  IMAGE
  VIDEO
  BANNER
  CAROUSEL
}

enum CtaType {
  WHATSAPP
  PHONE
  WEBSITE
  EMAIL
  MAPS
  FORM
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdPlacement {
  ADMOB
  LOCAL
  BOTH
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SalaryStatus {
  PENDING
  PAID
}

enum ExpenseType {
  DOMAIN
  SERVER
  OTHER
}

// ─── Phase 1 Models ──────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  phone            String        @unique
  name             String?
  role             Role          @default(READER)
  articleReadCount Int           @default(0)
  fcmToken         String?
  preferredLang    String        @default("ta") // "ta" | "en"
  isBanned         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  articleReads     ArticleRead[]
  pushTokens       PushToken[]

  // Legacy Phase 2 relations (kept for forward compatibility)
  reporter         Reporter?
  comments         Comment[]
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  adminRole    AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  phone        String?
  teamType     String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Single-active-session enforcement — see AuthService.adminLogin. A fresh
  // random id is written here on every successful/confirmed login and
  // embedded in that login's JWTs as the `sid` claim; validateJwtPayload
  // rejects any token whose `sid` no longer matches, which is what actually
  // signs the *previous* device out the next time it makes a request.
  // Cleared (set to null) on an explicit logout. Device/IP/At are purely
  // informational — shown to the person logging in ("already signed in on
  // Chrome on Windows since 2:30 PM") and to a Super Admin on the Admin
  // Accounts page (with a Force Logout action that just clears these).
  activeSessionId     String?
  activeSessionDevice String?
  activeSessionIp     String?
  activeSessionAt     DateTime?

  articles     Article[]
  auditLogs    AuditLog[]
  mediaFiles   MediaFile[]
  localAds     LocalAd[]

  // Task-assignment system (My Profile page): tasks this admin was given,
  // and tasks this admin handed out to others. See Task model below for the
  // assignment-hierarchy rule enforced in tasks.service.ts.
  tasksAssignedToMe Task[] @relation("TaskAssignedTo")
  tasksICreated     Task[] @relation("TaskAssignedBy")

  // Support tickets (My Profile "Support" tab): issues a Manager/Member
  // raises for an Admin/Super Admin to resolve. See Ticket model below.
  ticketsRaised   Ticket[] @relation("TicketRaisedBy")
  ticketsResolved Ticket[] @relation("TicketResolvedBy")

  // Workforce module (attendance/hours/payment) — see HR models below.
  dailyActivity    AdminDailyActivity[]
  salaryRecords    AdminSalaryRecord[] @relation("SalaryOwner")
  salariesRecorded AdminSalaryRecord[] @relation("SalaryRecordedBy")
  hrAccessGrant    HRAccessGrant?      @relation("HRGrantee")
  hrGrantsGiven    HRAccessGrant[]     @relation("HRGrantedBy")
  expensesRecorded RecurringExpense[]  @relation("ExpenseRecordedBy")
}

model Category {
  id           String    @id @default(uuid())
  nameTa       String
  nameEn       String
  slug         String    @unique
  iconUrl      String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  articles     Article[]
}

model Article {
  id           String        @id @default(uuid())
  titleTa      String
  titleEn      String
  bodyTa       String
  bodyEn       String
  excerpt      String?
  thumbnailUrl String?
  // Extra gallery photos/videos beyond the single thumbnail — see
  // CreateArticleDto.mediaUrls. Empty by default; the reader app falls
  // back to a single-image card using thumbnailUrl when this is empty.
  mediaUrls    String[]      @default([])
  byline       String?       // "by Publisher Name" shown in reader app
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  adminId      String
  admin        Admin         @relation(fields: [adminId], references: [id])
  status       ArticleStatus @default(DRAFT)
  isBreaking   Boolean       @default(false)
  cardStyle    CardStyle     @default(STANDARD)

  // Manual homepage curation (website only — see HomepageView in
  // apps/website/app/page.tsx). When isFeatured is set, the article is
  // eligible for the hero "lead story"/"side stories" slots, ordered by
  // featuredOrder (lower = earlier/lead). GET /news/homepage-picks fills
  // any remaining slots (below 3) with the newest published articles.
  isFeatured    Boolean      @default(false)
  featuredOrder Int?

  // True once thumbnailUrl's actual file has the brand logo baked into its
  // pixels (see MediaService.bakeWatermark, called by the admin panel right
  // after upload). The website uses this to decide whether it still needs
  // to draw the on-page ImageWatermark overlay for this article's hero
  // image — baked images don't need it (would double up the logo); older
  // articles uploaded before this feature existed default to false, so
  // they keep the overlay as their only protection.
  thumbnailWatermarked Boolean @default(false)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Reaction counters — increment-only from the client, deduped on-device
  // (AsyncStorage) rather than per-account, so guests can react too. Not a
  // full Like junction table by design: this app's read model is guest-
  // first (most installs never log in), so a per-user unique constraint
  // would exclude the majority of reactions.
  likeCount    Int           @default(0)
  dislikeCount Int           @default(0)
  commentCount Int           @default(0)

  // Total view counter — same increment-only, deduped-on-device model as
  // the reaction counters above (see PATCH /news/:id/view). Admin-panel-
  // only metric: not shown to readers on the website/app, just to admins
  // tracking article performance.
  viewCount    Int           @default(0)

  // Precomputed at create/update time (see news.service.ts's buildSearchText)
  // — a normalized blob combining a phonetic Tamil->Latin transliteration of
  // titleTa/bodyTa with titleEn/excerpt/byline, so a reader typing in plain
  // English or Thanglish (e.g. "mazhai") still finds Tamil-only articles
  // (e.g. "மழை") in Archive/Search. Not shown anywhere — search index only.
  searchText   String?       @db.Text

  reads        ArticleRead[]
  comments     Comment[]

  @@index([isFeatured, featuredOrder])
}

model ArticleRead {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  readAt    DateTime @default(now())

  @@unique([userId, articleId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fcmToken  String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  device     String?
  createdAt  DateTime @default(now())
}

model MediaFile {
  id        String   @id @default(uuid())
  filename  String
  url       String
  publicId  String
  mimeType  String
  size      Int      @default(0)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}

model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model LocalAd {
  id             String      @id @default(uuid())
  title          String
  description    String?
  adType         AdType
  mediaUrl       String?
  carousel       Json?       // array of image URLs for CAROUSEL type
  startDate      DateTime
  endDate        DateTime
  categoryId     String?
  targetAudience String?
  priority       Int         @default(0)
  status         AdStatus    @default(DRAFT)
  ctaType        CtaType
  ctaValue       String      // WhatsApp number, phone, URL, email, coordinates, etc.
  placement      AdPlacement @default(BOTH)
  clickCount     Int         @default(0)
  impressions    Int         @default(0)
  adminId        String
  admin          Admin       @relation(fields: [adminId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Team {
  id          String   @id @default(uuid())
  name        String
  nameTa      String?
  type        String   @unique  // e.g. 'EDITOR_TEAM', 'EDITORIAL_SPORTS'
  description String?
  color       String   @default("#CC1F2D")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Task-assignment system, part of the "My Profile" feature. Assignment
// hierarchy (enforced in tasks.service.ts, not by the schema):
//   - SUPER_ADMIN / ADMIN -> any Manager or Member, any team
//   - *_MANAGER            -> *_MEMBER on their own team only (teamType match)
//   - *_MEMBER / EDITOR     -> cannot assign, can only update their own
//                              task's status
model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus @default(NEW)
  assignedToId String
  assignedTo   Admin      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   Admin      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignedToId, status])
  @@index([assignedById])
}

// Support tickets, part of the "My Profile" feature. Any Manager or Member
// (any non-SUPER_ADMIN/ADMIN role) can raise one; any SUPER_ADMIN/ADMIN can
// see the shared pool and resolve it (enforced in tickets.service.ts, same
// pattern as Task above — not modeled here since it's a fixed two-tier
// split, unlike Task's team-scoped manager rule).
model Ticket {
  id             String         @id @default(uuid())
  title          String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  // Screenshots/photos the raiser attaches to illustrate the issue —
  // uploaded client-side to Cloudinary same as avatars/thumbnails, URLs
  // only stored here.
  attachmentUrls String[]       @default([])
  resolutionNote String?
  raisedById     String
  raisedBy       Admin          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  resolvedById   String?
  resolvedBy     Admin?         @relation("TicketResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([raisedById])
}

// ─── Workforce: Attendance / Active-Hours / Payroll / Access Grants ──────────
// "Super Admin add new features for all type of user ... performances, no
// of hours active, daily attendance, month attendance and payment" — this
// section, plus the existing Reports (performance) endpoints in admin.
// service.ts, together back the admin-panel's Workforce page.

// Heartbeat-based attendance — the admin panel pings PATCH /hr/heartbeat
// roughly every 60s while its tab is open and visible (see
// AttendanceHeartbeat.tsx). Each ping upserts *today's* row for that admin
// and bumps activeMinutes by the gap since lastSeenAt (capped, so a laptop
// left open overnight or a stale tab can't inflate the count). A day with a
// row = present; no row = absent. There is no reliable client-side "logout"
// signal for a JWT-based SPA, so presence is measured by "did we hear from
// this person today" rather than an explicit clock-in/out action.
model AdminDailyActivity {
  id            String    @id @default(uuid())
  adminId       String
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  activeMinutes Int       @default(0)
  firstSeenAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([adminId, date])
  @@index([date])
}

// Simple payroll log, not a payment gateway — Super Admin (or a person
// granted HR edit access) enters an amount per admin per month and marks it
// Paid/Pending. No money actually moves through this table.
model AdminSalaryRecord {
  id           String       @id @default(uuid())
  adminId      String
  admin        Admin        @relation("SalaryOwner", fields: [adminId], references: [id], onDelete: Cascade)
  month        Int          // 1-12
  year         Int
  amount       Decimal      @default(0) @db.Decimal(10, 2)
  status       SalaryStatus @default(PENDING)
  paidAt       DateTime?
  notes        String?
  recordedById String?
  recordedBy   Admin?       @relation("SalaryRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([adminId, month, year])
  @@index([adminId])
}

// Per-admin HR access grant. Default (no row, or SUPER_ADMIN) behavior:
// SUPER_ADMIN always has full view+edit access to everyone; everyone else
// has none. Super Admin can toggle canView/canEdit on for a specific ADMIN
// or *_MANAGER here — see HrAccessGuard for how the resulting scope (all
// admins for a plain ADMIN grantee, own-team-only for a *_MANAGER grantee)
// is derived at request time.
model HRAccessGrant {
  id          String   @id @default(uuid())
  adminId     String   @unique
  admin       Admin    @relation("HRGrantee", fields: [adminId], references: [id], onDelete: Cascade)
  canView     Boolean  @default(false)
  canEdit     Boolean  @default(false)
  grantedById String?
  grantedBy   Admin?   @relation("HRGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Organization-wide recurring costs (domain registration, server/VPS
// hosting, and anything else billed on a schedule) — not tied to any one
// admin or team the way salary is, so it's not scoped by HrAccessGuard's
// team dimension: anyone with Workforce view/edit access sees and manages
// the whole list, same as Super Admin. Lives in the Workforce > Payment
// tab's "Renewals" section, next to salary.
model RecurringExpense {
  id           String       @id @default(uuid())
  name         String       // e.g. "agnisiragu.com", "Hostinger VPS"
  type         ExpenseType  @default(OTHER)
  provider     String?      // e.g. "GoDaddy", "Hostinger", "AWS"
  amount       Decimal      @default(0) @db.Decimal(10, 2)
  renewalDate  DateTime     // next due date
  status       SalaryStatus @default(PENDING)
  notes        String?
  recordedById String?
  recordedBy   Admin?       @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([renewalDate])
}

// ─── Legacy / Phase 2 Models (kept, not used in Phase 1 APIs) ────────────────

model Reporter {
  id          String         @id @default(uuid())
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id])
  realName    String
  penName     String
  usePenName  Boolean        @default(true)
  trustScore  Int            @default(50)
  status      ReporterStatus @default(TEMPORARY)
  strikeCount Int            @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  news        News[]
  rewards     Reward[]
}

model News {
  id          String       @id @default(uuid())
  title       String
  body        String
  mediaUrl    String?
  audioUrl    String?
  category    String
  reporterId  String
  reporter    Reporter     @relation(fields: [reporterId], references: [id])
  status      NewsStatus   @default(PENDING)
  priority    NewsPriority @default(REGULAR)
  location    String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  rewards     Reward[]
}

model Reward {
  id         String   @id @default(uuid())
  reporterId String
  reporter   Reporter @relation(fields: [reporterId], references: [id])
  newsId     String
  news       News     @relation(fields: [newsId], references: [id])
  points     Int
  category   String
  claimed    Boolean  @default(false)
  week       String
  paidAt     DateTime?
  createdAt  DateTime @default(now())
}

// Comments on live Article records (Phase 1). Originally modeled against
// the legacy News table — repointed to Article since News/Reporter are
// unused by any Phase 1 API and this model had zero prior usage anywhere
// in the codebase (safe rename, not a breaking change to anything live).
// Reading comments is public; posting requires a logged-in User (phone OTP
// or Google — see auth.controller.ts) enforced in comments.controller.ts.
model Comment {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  isToxic   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}
